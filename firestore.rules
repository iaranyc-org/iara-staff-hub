rules_version = '2';

// iara Lineup.
//
// Two kinds of session.
//
// 1. The team shares one account (staff@iara.nyc) using the password they are
//    given. That is deliberate: a password compared in JavaScript protects
//    nothing, because anyone can talk to Firestore directly. Requiring a real
//    session here is what actually closes it.
//
// 2. Managers additionally sign in with Google on a second Firebase app
//    instance, so the manager token and the shared staff token coexist. The
//    allowlist below is the real gate for manager-only actions. The copy in
//    the app is a courtesy, not a control.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Keep this list in step with MANAGERS in the app. This one is what counts.
    function isManager() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'ronald@iara.nyc',
             'vitor@iara.nyc',
             'jay@iara.nyc'
           ];
    }

    // One document per staff member, plus their quiz attempts.
    //
    // 'get' stays open to the shared account because the app reads and writes
    // the current device's own record. 'list' is manager-only, so a curious
    // server cannot enumerate the roster and read everyone else's scores.
    //
    // Honest limit: with one shared account Firestore cannot tell one server
    // from another, so someone who already knows another person's id could
    // still read that record. Closing that properly means per-person accounts.
    match /staff/{staffId} {
      allow get: if signedIn();
      allow list: if isManager();
      allow write: if signedIn();

      match /quizzes/{quizId} {
        allow read: if signedIn();
        allow write: if signedIn();
      }
    }

    // The menu. Everyone signed in reads it; only a manager may change it.
    match /menu_items/{itemId} {
      allow read: if signedIn();
      allow write: if isManager();
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
