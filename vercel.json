{
  "rewrites": [
    {
      "source": "/home",
      "destination": "https://iara-inbox.vercel.app/inbox/home"
    },
    {
      "source": "/",
      "destination": "/iara_hub.html"
    },
    {
      "source": "/lineup",
      "destination": "/iara_staff_hub.html"
    },
    {
      "source": "/lineup/:path*",
      "destination": "/iara_staff_hub.html"
    },
    {
      "source": "/ops",
      "destination": "/iara_kitchen_ops.html"
    },
    {
      "source": "/analytics",
      "destination": "/iara_analytics.html"
    },
    {
      "source": "/private-dining",
      "destination": "https://iara-private-dining.vercel.app/private-dining"
    },
    {
      "source": "/private-dining/:path*",
      "destination": "https://iara-private-dining.vercel.app/private-dining/:path*"
    },
    {
      "source": "/inbox",
      "destination": "https://iara-inbox.vercel.app/inbox"
    },
    {
      "source": "/inbox/:path*",
      "destination": "https://iara-inbox.vercel.app/inbox/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/phone",
      "destination": "/analytics#t=phone",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/kit/:file*",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/lineup.js",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
