{
  "rewrites": [
    {
      "source": "/",
      "destination": "/iara_hub.html"
    },
    {
      "source": "/lineup",
      "destination": "/iara_staff_hub.html"
    },
    {
      "source": "/lineup/:path*",
      "destination": "/iara_staff_hub.html"
    },
    {
      "source": "/ops",
      "destination": "/iara_kitchen_ops.html"
    },
    {
      "source": "/phone",
      "destination": "/iara_phone.html"
    }
  ],
  "functions": {
    "api/phone-stats.js": {
      "maxDuration": 60
    }
  }
}